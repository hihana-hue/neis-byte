<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:clipToOutline="true" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingVertical="4dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:id="@+id/heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="CHOI RIVER 포레버" android:textColor="#175775" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
  <TextView android:id="@+id/settings" android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center" android:text="⚙" android:textColor="#4F7184" android:textSize="14sp" android:contentDescription="위젯 연결 설정"/>
  <TextView android:id="@+id/refresh" android:layout_width="26dp" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textColor="#19799F" android:textSize="19sp" android:contentDescription="일정 새로고침"/>
 </LinearLayout>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="none"/>
  <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="위젯 연결 코드를 등록해 주세요." android:textColor="#486B7C" android:textSize="11sp"/>
 </FrameLayout>
</LinearLayout>
</FrameLayout>