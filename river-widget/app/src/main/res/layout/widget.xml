<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:clipToOutline="true" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginBottom="0dp" android:gravity="center_vertical" android:orientation="horizontal">
   <TextView android:id="@+id/heading" android:layout_width="wrap_content" android:maxWidth="170dp" android:layout_height="match_parent" android:gravity="center_vertical" android:includeFontPadding="false" android:text="나의 일정" android:textColor="#175775" android:textSize="12sp" android:textStyle="normal" android:singleLine="true" android:ellipsize="end"/>
   <ImageView android:id="@+id/refresh" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_refresh" android:contentDescription="일정 새로고침"/>
   <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="20dp" android:importantForAccessibility="no"/>
   <ImageView android:id="@+id/settings" android:layout_width="40dp" android:layout_height="40dp" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_settings" android:contentDescription="위젯 설정"/>
  </LinearLayout>
  <FrameLayout android:id="@+id/content_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
   <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="none" android:paddingBottom="6dp" android:clipToPadding="true" android:overScrollMode="ifContentScrolls"/>
   <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="위젯 연결 코드를 등록해 주세요." android:textColor="#486B7C" android:textSize="11sp"/>
  </FrameLayout>
 </LinearLayout>
</FrameLayout>

